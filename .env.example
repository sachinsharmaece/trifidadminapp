VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=TriFid Desks
VITE_ENV=development
# Temporary client-walkthrough aid: shows a collapsible "what this screen
# does" note on every screen. Off by default; remove once the client
# walkthrough is done (see src/lib/devNotes.ts).
VITE_SHOW_DEV_NOTES=false
# Developer addition — never honoured when VITE_ENV=production (see
# src/components/ui/Input.tsx). Set to "true" to drop the `required`
# attribute on every form field so forms can be submitted empty for testing.
VITE_DISABLE_INPUT_VALIDATION=false
