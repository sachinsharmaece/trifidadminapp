# Copy to `.env` (or `.env.local`) and adjust:  copy .env.example .env

# Base URL every API call is made against.
# Default `/api/v1` is same-origin: in dev, Vite forwards /api to VITE_DEV_PROXY_TARGET below.
# For a build that talks to another host, use a full URL, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# Dev server only: where Vite forwards /api requests.
# Must match PORT in trifidserverapp's .env (both default to 4000).
VITE_DEV_PROXY_TARGET=http://localhost:4000
